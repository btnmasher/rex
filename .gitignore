# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env

# Planning documents are local project context.
.plans/

# Local alert routing configuration contains webhook secrets.
alert-destinations.json
alert-destinations.yml

# Local SQLite databases and journaling sidecars.
*.sqlite*

# Build artifacts
bin/
.tmp/
.task/
.bun/
*.zip
.cache/
.gocache/
*.syso
*.o

# local dev artifacts
pb_data/
/logs/
.logs/
.data/
*.local.yml
docker-compose.override.yml

# Editor/IDE
.idea/
.vscode/
.zed/
