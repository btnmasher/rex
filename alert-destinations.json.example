{
  "version": 1,
  "destinations": [
    {
      "name": "military-alerts",
      "filters": {
        "alertTypes": [
          "sovereignty.entosis",
          "sovereignty.events",
          "structures.combat",
          "structures.integrity",
          "structures.state.reinforced",
          "structures.state.low_power",
          "skyhooks.under_attack",
          "skyhooks.lost_shields",
          "skyhooks.destroyed",
          "starbase.under_attack"
        ],
        "excludeStructureTypeIDs": ["85230", "85980"]
      },
      "presentation": {
        "showEntityIDs": false
      },
      "delivery": {
        "type": "discord",
        "senderName": "Example Alerts",
        "senderAvatarURL": "https://example.invalid/avatar.png",
        "targets": [
          {
            "id": "primary",
            "webhookUrl": "https://discord.com/api/webhooks/replace-me"
          },
          {
            "id": "secondary",
            "webhookUrl": "https://discord.com/api/webhooks/replace-me-2"
          }
        ]
      }
    },
    {
      "name": "logistics-alerts",
      "filters": {
        "alertTypes": [
          "sovereignty.events",
