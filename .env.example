DATABASE_URL=postgres://user:password@db.example.invalid:5432/auth_next?sslmode=verify-full
AUTH_NEXT_TOKEN_EXPORT_BASE_URL=http://localhost:3000
AUTH_NEXT_TOKEN_EXPORT_BEARER_TOKEN=replace-with-auth-next-export-bearer-token
# Number of access tokens requested per corporation, from 1 through 64.
AUTH_NEXT_TOKEN_EXPORT_COUNT=15
EVE_SSO_CLIENT_ID=replace-with-eve-client-id
ESI_BASE_URL=https://esi.evetech.net
ESI_COMPATIBILITY_DATE=2026-05-19
POLL_INTERVAL=1m
POLL_LOOKBEHIND=10m
HTTP_TIMEOUT=20s
JOB_STORE=memory
# Used when JOB_STORE=sqlite. The schema is initialized automatically.
JOB_STORE_SQLITE_PATH=rex-jobruntime.sqlite
# SQLite database for durable per-corporation notification cursors and deduplication.
NOTIFICATION_STATE_SQLITE_PATH=rex-notification-state.sqlite
# JSON or YAML file containing versioned destination filters and provider settings.
ALERT_DESTINATIONS_CONFIG=alert-destinations.json
LOG_LEVEL=INFO
LOG_PRETTY=false
LOG_PAYLOADS=false
